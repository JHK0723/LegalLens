          <mxGeometry x="25" y="45" width="380" height="260" as="geometry" />
        </mxCell>

        <!-- Component 1: User -->
        <mxCell id="user_node" value="&lt;div style=&quot;font-size: 14px; font-weight: bold; color: #1E293B;&quot;&gt;User&lt;/div&gt;&lt;div style=&quot;font-size: 11px; color: #64748B; margin-top: 4px;&quot;&gt;Web Browser / Client&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#64748B;strokeWidth=2;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="50" y="240" width="140" height="110" as="geometry" />
        </mxCell>

        <!-- Component 2: Frontend (React Web Application) -->
        <mxCell id="frontend_node" value="&lt;div style=&quot;font-size: 14px; font-weight: bold; color: #1E3A8A;&quot;&gt;Frontend&lt;/div&gt;&lt;div style=&quot;font-size: 12px; font-weight: bold; color: #2563EB;&quot;&gt;(React Web Application)&lt;/div&gt;&lt;hr style=&quot;border:0.5px solid #BFDBFE;margin:6px 0;&quot;/&gt;&lt;div style=&quot;font-size: 11px; color: #334155; text-align: left;&quot;&gt;• UI Dashboard &amp;amp; Controls&lt;br/&gt;• Upload Contract (PDF/DOCX)&lt;br/&gt;• Analysis &amp;amp; AI Chat Interface&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#2563EB;strokeWidth=2;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="235" y="220" width="200" height="150" as="geometry" />
        </mxCell>

        <!-- Component 3: Backend (FastAPI REST API) inside Docker Container -->
        <mxCell id="backend_node" value="&lt;div style=&quot;font-size: 14px; font-weight: bold; color: #14532D;&quot;&gt;Backend&lt;/div&gt;&lt;div style=&quot;font-size: 12px; font-weight: bold; color: #16A34A;&quot;&gt;(FastAPI REST API)&lt;/div&gt;&lt;hr style=&quot;border:0.5px solid #BBF7D0;margin:6px 0;&quot;/&gt;&lt;div style=&quot;font-size: 11px; color: #1E293B; text-align: left;&quot;&gt;• REST API Endpoints&lt;br/&gt;• JWT Auth &amp;amp; OAuth Handler&lt;br/&gt;• Analysis &amp;amp; Risk Engine&lt;br/&gt;• OpenAI Integration Service&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0FDF4;strokeColor=#16A34A;strokeWidth=2;shadow=1;" vertex="1" parent="docker_container">
          <mxGeometry x="25" y="45" width="330" height="190" as="geometry" />
        </mxCell>

        <!-- Component 6: PostgreSQL Database inside Cloud Deployment -->
        <mxCell id="postgres_node" value="&lt;div style=&quot;font-size: 13px; font-weight: bold; color: #78350F;&quot;&gt;PostgreSQL Database&lt;/div&gt;&lt;hr style=&quot;border:0.5px solid #FDE68A;margin:4px 0;&quot;/&gt;&lt;div style=&quot;font-size: 11px; color: #92400E; text-align: left;&quot;&gt;• User Accounts &amp;amp; Auth Data&lt;br/&gt;• Contract History Metadata&lt;br/&gt;• Analysis Results (Summaries,&lt;br/&gt;  Risk &amp;amp; Fairness Scores)&lt;/div&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#FEF3C7;strokeColor=#D97706;strokeWidth=2;shadow=1;" vertex="1" parent="cloud_deployment">
