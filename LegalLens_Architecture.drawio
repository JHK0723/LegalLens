  <diagram id="legallens-architecture" name="LegalLens Architecture">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Title Banner -->
        <mxCell id="title_banner" value="&lt;div style=&quot;font-size: 18px; font-weight: bold; color: #FFFFFF; text-align: center;&quot;&gt;LegalLens – AI-Powered Contract Analysis and Legal Assistant&lt;/div&gt;&lt;div style=&quot;font-size: 12px; color: #CBD5E1; text-align: center; margin-top: 4px;&quot;&gt;Software Architecture Diagram | System Data Flow &amp;amp; Infrastructure Overview&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0F172A;strokeColor=#1E293B;strokeWidth=2;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="25" width="1089" height="65" as="geometry" />
        </mxCell>

        <!-- Cloud Deployment Boundary (Render / AWS Cloud) -->
        <mxCell id="cloud_deployment" value="&lt;div style=&quot;font-size: 14px; font-weight: bold; color: #3730A3;&quot;&gt;☁️ Cloud Deployment (Render or AWS Cloud)&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;dashPattern=8 4;fillColor=#EEF2FF;strokeColor=#4F46E5;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=15;spacingTop=12;" vertex="1" parent="1">
          <mxGeometry x="470" y="110" width="430" height="580" as="geometry" />
        </mxCell>

        <!-- Docker Container (Hosts Backend) -->
