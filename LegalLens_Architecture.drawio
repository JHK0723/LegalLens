        <mxCell id="legend_cloud_text" value="&lt;b style=&quot;color:#1E293B;&quot;&gt;Cloud&lt;/b&gt; = External Service / Deployment" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=11;fontColor=#334155;" vertex="1" parent="legend_box">
