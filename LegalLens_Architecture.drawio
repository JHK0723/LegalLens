        <!-- DATA FLOW CONNECTIONS -->

        <!-- Data Flow 1: User → Frontend -->
        <mxCell id="flow_user_frontend" value="User Access" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#475569;strokeWidth=2;endArrow=classic;endSize=6;fontSize=11;fontColor=#334155;fontStyle=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="user_node" target="frontend_node">
          <mxGeometry relative="1" as="geometry" />
