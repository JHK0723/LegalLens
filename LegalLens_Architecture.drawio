        <mxCell id="flow_backend_postgres" value="User Accounts, Contract History &amp;amp; Analysis Results" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#D97706;strokeWidth=2;startArrow=classic;endArrow=classic;startSize=6;endSize=6;fontSize=11;fontColor=#92400E;fontStyle=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="cloud_deployment" source="docker_container" target="postgres_node">
